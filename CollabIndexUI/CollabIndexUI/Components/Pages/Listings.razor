@page "/Listings"
@using CollabIndexUI.ApiServices
@using CollabIndexUI.Models
@rendermode InteractiveServer

<PageTitle>Listed Projects</PageTitle>
@inject ApiService ApiService


@*

<MudText Typo="Typo.h6">MudBlazor is @Text</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ButtonOnClick">@ButtonText</MudButton>
 *@


@if (projects == null)
{
    <p>Loading projects...</p>
}
else
{
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            <!---- Search bar section -->
            <MudGrid GutterSize="2">
                <!-- Left Column (Empty for now) -->
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" GutterBottom="true">Community Takeover Projects</MudText>
                </MudItem>

                <!-- Right Column: Search Widget -->
                <MudItem xs="20" md="4" Class="d-flex justify-end">
                    <MudForm>
                        <MudTextField @bind-Value="SearchTextFieldLabel" Label="Search Name or CA" Variant="Variant.Outlined"></MudTextField>
                    </MudForm>
                </MudItem>
            </MudGrid>

            <!---- listing cards section-->
            <MudGrid GutterSize="2">
                @foreach (var project in projects)
                {
                    <MudItem xs="12" sm="6" md="4" Class="p-2">
                        <MudCard Style="height: 100%; position: relative; border: 1px solid #c0c0c0; padding-bottom: 16px;">
                            <MudCardContent>
                                <MudText Typo="Typo.h6">@project.ProjectName</MudText>
                                <MudText Typo="Typo.body2">@project.Description</MudText>
                            </MudCardContent>


                            <!-- Border to Separate Icons -->
                            <hr style="border: 1px solid #c0c0c0; margin: 8px 0;" />


                            <MudCardActions Style="justify-content: space-around; padding: 1rem;">
                                <!-- DexScreener Link -->
                                <MudIconButton Icon="@Icons.Material.Filled.ShowChart" Color="Color.Primary" Target="_blank"
                                               Href="@project.DexScreenerLink" />

                                <!-- Telegram Link -->
                                <MudIconButton Icon="@Icons.Material.Filled.AddHome" Color="Color.Primary" Target="_blank"
                                               Href="@project.TelegramLink" />

                                <!-- Twitter Link -->
                                <MudIconButton Icon="@Icons.Material.Filled.AccountBox" Color="Color.Primary" Target="_blank"
                                               Href="@project.TwitterLink" />
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    
}

@code {

    public string Text { get; set; } = "????";
    public string ButtonText { get; set; } = "Click Me";
    public int ButtonClicked { get; set; }
    public string SearchTextFieldLabel { get; set; } = "";

    private List<ListedProject> projects = new List<ListedProject>
    {
        new ListedProject
        {
            ListingId = 1,
            ProjectName = "Project Phoenix",
            TwitterLink = "https://twitter.com/projectphoenix",
            DexScreenerLink = "https://dexscreener.com/projectphoenix",
            Description = "A community-driven effort to revive a promising project.",
            CreatedDate = DateTime.Now.AddDays(-10)
        },
        new ListedProject
        {
            ListingId = 2,
            ProjectName = "RuggedDAO Takeover",
            TwitterLink = "https://twitter.com/ruggeddao",
            DexScreenerLink = "https://dexscreener.com/ruggeddao",
            Description = "Decentralized effort to restore and boost a rugged token.",
            CreatedDate = DateTime.Now.AddDays(-5)
        },
        new ListedProject
        {
            ListingId = 3,
            ProjectName = "Project Revival",
            TwitterLink = "https://twitter.com/projectrevival",
            DexScreenerLink = "https://dexscreener.com/projectrevival",
            Description = "A collaborative effort to bring an abandoned project back to life.",
            CreatedDate = DateTime.Now.AddDays(-7)
        },
    };

    protected override async Task OnInitializedAsync()
    {
        //projects = this.projects;
        //await ApiService.GetProjectsAsync();
    }

    void ButtonOnClick()
    {
